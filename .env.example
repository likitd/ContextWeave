# Copy this file to .env and replace values where needed.
# .env is ignored by git; never commit API keys or other secrets.

# -----------------------------------------------------------------------------
# LLM provider (OpenAI-compatible API)
# -----------------------------------------------------------------------------
# Local Ollama defaults:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b-cloud

# Example for an OpenAI-compatible hosted provider:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=replace-with-a-supported-model
LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Embeddings (Ollama-compatible endpoint)
# -----------------------------------------------------------------------------
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest
LIGHTRAG_EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Retrieval and indexing
# -----------------------------------------------------------------------------
# auto | hybrid | agentfs | lightrag
STRATEGY=lightrag
CONTEXT_FOLDER=context
CHROMA_PERSIST_DIR=chroma_db
LIGHTRAG_WORKING_DIR=lightrag_storage
LIGHTRAG_MODE=hybrid

# Set these to false when you want to preserve an existing index on reruns.
FRESH_INDEX=true
FRESH_LIGHTRAG_INDEX=true

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BM25_TOP_K=10
VECTOR_TOP_K=10
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# LightRAG uses the main LLM settings unless overridden here.
# LIGHTRAG_LLM_BASE_URL=https://api.openai.com/v1
# LIGHTRAG_LLM_API_KEY=replace-with-your-api-key
# LIGHTRAG_LLM_MODEL=replace-with-a-supported-model
